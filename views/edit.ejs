<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note</title>

    <link rel="stylesheet" href="/stylesheets/output.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>

    <div class="min-h-screen bg-zinc-900 p-10">

        <!-- Back Button -->
        <a href="/" class="text-blue-500 hover:underline">
            ← Back to Home
        </a>

        <!-- Edit Form -->
        <div class="mt-8">
            <form action="/edit/<%= filename %>" method="post">

                <!-- Title -->
                <input
                    class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800 text-white"
                    type="text"
                    name="title"
                    value="<%= filename.replace('.txt','') %>">

                <!-- Description -->
                <textarea
                    class="block w-full rounded-md outline-none mt-3 px-5 py-2 resize-none bg-zinc-800 text-white h-60"
                    name="details" placeholder="description..."><%= filedata %></textarea>

                <!-- Update Button -->
                <input
                    class="mt-3 bg-green-600 hover:bg-green-700 px-5 py-2 rounded-md text-white cursor-pointer"
                    type="submit"
                    value="Update Task">

            </form>
        </div>

    </div>

</body>
</html>