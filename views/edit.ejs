<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note</title>

    <link rel="stylesheet" href="/stylesheets/output.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>

<div class="min-h-screen bg-zinc-900">

    <!-- Header -->
    <div class="max-w-5xl mx-auto px-8 pt-10">

        <a
            href="/"
            class="text-blue-400 hover:text-blue-300 transition">
            ← Back to Home
        </a>

        <h1 class="text-5xl font-bold text-white mt-6">
            Edit Note
        </h1>

        <p class="text-zinc-400 mt-2">
            Update your note and save the changes.
        </p>

    </div>

    <!-- Edit Form -->
    <div class="max-w-5xl mx-auto px-8 py-10">

        <form action="/edit/<%= filename %>" method="post">

            <!-- Title -->
            <input
                class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-5 py-3 text-white outline-none focus:border-green-500 transition"
                type="text"
                name="title"
                value="<%= filename.replace('.txt','') %>"
                required>

            <!-- Description -->
            <textarea
                class="w-full mt-5 bg-zinc-800 border border-zinc-700 rounded-xl px-5 py-3 text-white outline-none resize-none h-72 focus:border-green-500 transition"
                name="details"
                required><%= filedata %></textarea>

            <!-- Buttons -->
            <div class="flex gap-4 mt-6">

                <button
                    class="bg-green-600 hover:bg-green-700 transition duration-300 px-6 py-3 rounded-xl text-white font-semibold cursor-pointer">
                     Update Note
                </button>

                <a
                    href="/"
                    class="bg-zinc-700 hover:bg-zinc-600 transition duration-300 px-6 py-3 rounded-xl text-white font-semibold">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

</body>
</html>